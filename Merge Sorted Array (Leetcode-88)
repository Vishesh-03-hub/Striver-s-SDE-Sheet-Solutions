class Solution {
    public void merge(int[] nums1, int m, int[] nums2, int n) 
    {
        int left = m-1;
        int right = 0;

        while( left >= 0 && right < n)
        {
            if(nums1[left] > nums2[right])
            {
                int t = nums1[left];
                nums1[left] = nums2[right];
                nums2[right] = t;
                left--;
                right++;
            }
            else
            {
                break;
            }
        }
        Arrays.sort(nums1,0,m);
        Arrays.sort(nums2);
        int ind = 0;

        for(int i = m; i < m+n; i++)
        {
            nums1[i] = nums2[ind++];
        }        
    }
}



**** USING SHELL SORT ****

class Solution 
{
    private void swapifgreater(int[] nums1, int[] nums2, int left, int right)
    {
        if(nums1[left] > nums2[right])
        {
            int t = nums1[left];
            nums1[left] = nums2[right];
            nums2[right] = t;
        }
    }
    public void merge(int[] nums1, int m, int[] nums2, int n) 
    {
        int len = m + n;
        int gap = len/2 + len%2;

        while( gap > 0)
        {
            int left = 0, right = left + gap;

        while(right < len)
        {
            if(right < m)
            {
                swapifgreater(nums1, nums1, left, right);
            }
            else if(left >= m)
            {
                swapifgreater(nums2, nums2, left - m, right - m);
            }
            else 
            {
                swapifgreater(nums1, nums2, left, right - m);
            }
            left++;
            right++;
        }
        if(gap == 1) break;
        gap = gap/2 + gap%2;        
    }
    for(int i = 0; i < n; i++)
    nums1[m+i] = nums2[i];
    }
}
