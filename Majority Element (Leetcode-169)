class Solution 
{
    public int majorityElement(int[] nums) 
    {
        int cnt = 0;
        int el = nums[0];

        for(int i = 0; i < nums.length; i++)
        {
            if(cnt == 0)
            el = nums[i];
            if(el == nums[i])
            cnt++;
            else
            cnt--;            
        }

        int el_cnt=0;
        for(int i:nums)
        {
            if(el == i)
            el_cnt++;
        }
        return el;
    }
}
