class Solution 
{
    public ListNode middleNode(ListNode head) 
    {
        ListNode temp = head;
        int cnt = 0;
        while(temp != null)
        {
            cnt++;
            temp = temp.next;
        }
        int midNode = cnt/2 + 1;
        temp = head;
        while(--midNode != 0)
        {
            temp = temp.next;
        }
        return temp;
    }
}


**** Tortoise & Hare Algorithm ****

class Solution 
{
    public ListNode middleNode(ListNode head) 
    {
        ListNode slow = head;
        ListNode fast = head;
        while(slow != null &&(fast != null && fast.next != null))
        {
            slow = slow.next;
            fast = fast.next.next;
        }
        return slow;
    }
}
