class Solution 
{
    public boolean searchMatrix(int[][] matrix, int target) 
    {
        int m = matrix.length;
        int n = matrix[0].length;
        boolean flag = false;
        
        if(target < matrix[0][0] || target > matrix[m-1][n-1])
            return flag;
            
        if(n == 1)
        {
            for(int i = 0; i < m; i++) 
            {
                if(matrix[i][0] == target)
                    flag = true;
            }
            return flag; 
        }
        
        if(m == 1)
        {
            for(int i = 0; i < n; i++)
            {
                if(matrix[0][i] == target)
                    flag = true;
            }
            return flag; 
        }

        for(int i = 1; i < m; i++)
        {
            if(matrix[i][0] > target)
            {
                for(int j = 0; j < n; j++)
                {
                    if(matrix[i-1][j] == target)
                        flag = true;
                }
                return flag; 
            }
            else if(target > matrix[i][0] && i == (m-1))
            {
                for(int k = 0; k < n; k++)
                {
                    if(matrix[i][k] == target)
                        flag = true;
                }
            }
            else if(matrix[i][0] == target) 
            {
                return true;
            }
        }
        return flag;
    }
}
