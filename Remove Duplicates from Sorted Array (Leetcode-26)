class Solution 
{
    public int removeDuplicates(int[] nums) 
    {
        int len=nums.length;
        int j=1,i=0;

        while(j < len)
        {
            if(nums[i] != nums[j])
            {
                nums[i+1]=nums[j];
                i++;
            }
            j++;
        }
        return i+1;
    }
}
