class Solution {
    public int maxProfit(int[] prices)
    {
        int i = 0, profit = 0;

        for(int j = 1; j < prices.length; j++)
        {
            if(prices[i] < prices[j])
            {
                profit = Math.max(profit, prices[j] - prices[i]);      
            }
            else
            {
                i = j;
            }
        }    
        return profit;    
    }
}
