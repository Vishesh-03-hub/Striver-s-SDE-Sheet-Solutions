class Solution 
{
    public int smallestNumber(int n, int t) 
    {
        int rem = 0, p = 1;
        for(int i = n; i >= n; i++)
        {
            int temp = i;
            while(temp > 0)
            {
                rem = temp % 10;
                p *= rem;
                temp /= 10;
            }
            if(p % t == 0)
            return i;
            p = 1;       
        } 
        return 0;
    }
}
