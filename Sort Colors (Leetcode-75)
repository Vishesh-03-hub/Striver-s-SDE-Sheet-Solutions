class Solution 
{
    public void sortColors(int[] nums) 
    {
        int left = 0;
        int mid = 0;
        int right = nums.length-1;

        while(mid <= right)
        {
            if(nums[mid] == 0)
            {
                int t = nums[mid];
                nums[mid] = nums[left];
                nums[left] = t;
                left++;
                mid++;
            }
            
            else if(nums[mid] == 1)
            mid++;
            
            else if(nums[mid] == 2)
            {
                int t=nums[mid];
                nums[mid]=nums[right];
                nums[right]=t;
                right--;
            }
        }
    }
}
