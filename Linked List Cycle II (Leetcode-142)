public class Solution 
{
    public ListNode detectCycle(ListNode head) 
    {
        ListNode slow = head;
        ListNode fast = head;
        boolean hasCycle = false;
        while(fast != null && fast.next != null)
        {
            slow = slow.next;
            fast = fast.next.next; 

            if(slow == fast)
            {
                hasCycle = true;
                break;
            }            
        }
        if(!hasCycle)
        return null;

        ListNode entry = head;
        while(entry != slow)
        {
            entry = entry.next;
            slow = slow.next;
        }
        return entry;
    }
}
