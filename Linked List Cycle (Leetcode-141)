****** Using HashMap(Hashing) ******
public class Solution 
{
    public boolean hasCycle(ListNode head) 
    {
        HashMap<ListNode, Integer> map = new HashMap<>();
        ListNode temp = head;

        while(temp != null)
        {
            if(map.containsKey(temp))
            return true;
            else
            {
                map.put(temp,1);
                temp = temp.next;
            }
        }
        return false;        
    }
}


***** Using Tortoise & Hare Approach *****
public class Solution 
{
    public boolean hasCycle(ListNode head) 
    {
        ListNode slow = head;
        ListNode fast = head;
        while(fast != null && fast.next != null)
        {
            slow = slow.next;
            fast = fast.next.next;
            if(fast == slow)
            return true;
        }
        return false;        
    }
}
